{
  "expo": {
    "name": "CogVest",
    "slug": "cogvest",
    "version": "1.0.31",
    "platforms": [
      "android"
    ],
    "orientation": "portrait",
    "icon": "./assets/brand/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "cogvest",
    "android": {
      "package": "com.abdulshaikh.cogvest",
      "versionCode": 32,
      "icon": "./assets/brand/icon.png",
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-icon-foreground.png",
        "backgroundColor": "#FFFFFF",
        "monochromeImage": "./assets/brand/android-monochrome-icon.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "./plugins/withPrivateReleaseSigning",
      "./plugins/withE2eBuildType",
      "./plugins/withPrivateDataBackupPolicy",
      "./plugins/withLeastPrivilegeAndroidPermissions",
      "./plugins/withBoundedDocumentRead",
      "./plugins/withModalAppearance",
      "./plugins/withStartupLinks",
      "./plugins/withAndroidBuildSettings",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#11181C"
        }
      ],
      "./plugins/withStartupWindow",
      "@react-native-community/datetimepicker",
      "expo-status-bar"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e831d362-739b-4075-95b7-f5f85a48e610"
      }
    },
    "owner": "abdul_shaikh_dev"
  }
}
