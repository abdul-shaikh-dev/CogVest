<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:gravity="center_vertical"
  android:orientation="horizontal">

  <ImageView
    android:layout_width="16dp"
    android:layout_height="16dp"
    android:layout_marginEnd="6dp"
    android:importantForAccessibility="no"
    android:src="@drawable/cogvest_widget_icon"
    android:tint="@color/cogvest_widget_accent" />

  <TextView
    android:id="@+id/cogvest_widget_title"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:ellipsize="end"
    android:maxLines="1"
    android:text="@string/cogvest_widget_title"
    android:textColor="@color/cogvest_widget_text_secondary"
    android:textSize="13sp"
    android:textStyle="bold" />
</LinearLayout>
