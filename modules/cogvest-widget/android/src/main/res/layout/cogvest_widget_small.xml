<?xml version="1.0" encoding="utf-8"?>
<!-- One row high: the icon and the value or state only. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@android:id/background"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/cogvest_widget_background"
  android:clipToOutline="true"
  android:contentDescription="@string/cogvest_widget_open"
  android:gravity="center_vertical"
  android:orientation="horizontal"
  android:paddingStart="14dp"
  android:paddingEnd="14dp"
  android:paddingTop="8dp"
  android:paddingBottom="8dp">

  <ImageView
    android:layout_width="20dp"
    android:layout_height="20dp"
    android:layout_marginEnd="8dp"
    android:importantForAccessibility="no"
    android:src="@drawable/cogvest_widget_icon"
    android:tint="@color/cogvest_widget_accent" />

  <TextView
    android:id="@+id/cogvest_widget_value"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:autoSizeMaxTextSize="22sp"
    android:autoSizeMinTextSize="14sp"
    android:autoSizeTextType="uniform"
    android:ellipsize="end"
    android:fontFeatureSettings="tnum"
    android:maxLines="1"
    android:textColor="@color/cogvest_widget_text_primary"
    android:textSize="22sp"
    android:textStyle="bold" />
</LinearLayout>
