{
  "name": "cogvest",
  "version": "1.0.30",
  "main": "./index.ts",
  "scripts": {
    "start": "expo start",
    "start:clear": "expo start --clear",
    "android": "expo run:android",
    "android:apk": "node scripts/android-build-apk.mjs",
    "android:apk:emulator": "node scripts/android-build-apk.mjs --architecture=x86_64",
    "android:apk:release": "node scripts/android-build-apk.mjs --release",
    "android:e2e": "node scripts/android-build-apk.mjs --e2e --architecture=x86_64",
    "doctor": "expo-doctor",
    "release:check-harness": "node scripts/check-release-harness.mjs",
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "android:doctor": "node scripts/android-doctor.mjs",
    "android:smoke": "node scripts/android-smoke-check.mjs",
    "test:verify": "npm run typecheck && npm run lint && npm run maestro:lint && npm test && npm run doctor",
    "test:v1:pc": "npm run test:verify && npm run android:doctor && npm run android:smoke -- --strict",
    "maestro:check": "node scripts/maestro-check.mjs",
    "maestro:test": "node scripts/maestro-run.mjs",
    "maestro:smoke": "node scripts/maestro-run.mjs --smoke",
    "maestro:lint": "node scripts/maestro-lint.mjs",
    "visual-qa:android": "node scripts/android-visual-qa.mjs",
    "ios": "expo run:ios"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts",
      "**/__tests__/**/*.test.tsx"
    ]
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-community/datetimepicker": "9.1.0",
    "decimal.js-light": "^2.5.1",
    "expo": "~57.0.32",
    "expo-application": "~57.0.3",
    "expo-constants": "~57.0.23",
    "expo-crypto": "~57.0.4",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.13",
    "expo-pdf-text-extract": "^1.1.0",
    "expo-router": "~57.0.30",
    "expo-splash-screen": "~57.0.11",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-gifted-charts": "^1.4.77",
    "react-native-mmkv": "^4.3.1",
    "react-native-nitro-modules": "0.37.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.86.3",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.10",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "expo-doctor": "^1.18.19",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.6",
    "react-test-renderer": "19.2.3",
    "ts-jest": "^29.4.9",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "@tootallnate/once": "^3.0.1",
    "postcss": "^8.5.10"
  },
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-file-system"
        ]
      }
    }
  },
  "private": true
}
